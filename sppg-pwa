<!doctype html>
<html lang="id">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
  <meta name="theme-color" content="#0f172a">
  <meta name="description" content="SPPG - Inventory & Stock Opname">
  <link rel="manifest" href="manifest.json">
  <link rel="icon" href="icon.svg" type="image/svg+xml">
  <link rel="icon" type="image/png" sizes="192x192" href="icon-192.png">
  <link rel="icon" type="image/png" sizes="512x512" href="icon-512.png">
  <link rel="apple-touch-icon" href="apple-touch-icon.png">
  <title>SPPG</title>
  <style>
    html,body{margin:0;width:100%;height:100%;background:#0f172a;font-family:Arial,sans-serif}
    #app{width:100%;height:100%;border:0;display:block}
    #loading{position:fixed;inset:0;display:grid;place-items:center;color:white;background:#0f172a;z-index:2}
    .box{text-align:center;padding:24px}.spin{font-size:32px;margin-bottom:12px}
    .error{max-width:620px;margin:auto;line-height:1.5}
    button{padding:10px 16px;border:0;border-radius:8px;cursor:pointer}
  </style>
</head>
<body>
  <div id="loading"><div class="box">
    <div class="spin">⏳</div>
    <div>Memuat SPPG...</div>
  </div></div>

  <iframe id="app" title="SPPG" allow="camera; microphone; geolocation"></iframe>

  <script src="config.js"></script>
  <script>
    const loading = document.getElementById("loading");
    const frame = document.getElementById("app");

    if (!APP_URL || APP_URL.includes("PASTE_URL")) {
      loading.innerHTML = '<div class="box error"><h2>Konfigurasi belum diisi</h2>' +
        '<p>Buka file <b>config.js</b>, lalu isi <b>APP_URL</b> dengan URL Web App Google Apps Script Anda yang berakhiran <b>/exec</b>.</p></div>';
    } else {
      // Teruskan parameter URL (mis. ?lisensi=KODE dari tautan aktivasi operator)
      // ke Apps Script di dalam iframe, supaya tautan yang dibagikan lewat domain
      // sendiri (mis. toolkiit.id/?lisensi=KODE) tetap berfungsi otomatis.
      frame.src = APP_URL + (window.location.search || "");
      frame.addEventListener("load", () => loading.style.display = "none");
      setTimeout(() => {
        if (loading.style.display !== "none") loading.style.display = "none";
      }, 12000);
    }

    if ("serviceWorker" in navigator) {
      window.addEventListener("load", () => navigator.serviceWorker.register("./sw.js").catch(console.error));
    }
  </script>
</body>
</html>

